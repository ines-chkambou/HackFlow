  </layout></widget><widget class="QWidget" name="pageApp"><property name="styleSheet"><string notr="true">QWidget#pageApp, QWidget#widgetMain { background-color: #101B31; }
QWidget { color: #FFFFFF; font-family: Calibri; font-size: 10pt; }
QLabel { background: transparent; }

/* ---- barre laterale ---- */
QFrame#frameSidebar { background-color: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #101B31, stop:1 #1B1244); border-right: 1px solid rgba(47,103,224,0.40); }
QLabel#labelBrand { font-family: Segoe UI; font-size: 16pt; font-weight: bold; color: #FFFFFF; }
QLabel#labelTagline { font-size: 6pt; color: #0BF8F6; }
QPushButton[nav=&quot;true&quot;] { background: transparent; border: none; border-radius: 9px; text-align: left; padding: 8px 14px; color: #AEBBDD; font-size: 10.5pt; }
QPushButton[nav=&quot;true&quot;]:hover { background-color: rgba(47,103,224,0.20); color: #FFFFFF; }
QPushButton[nav=&quot;true&quot;]:checked { background-color: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #4B26A0, stop:1 #2F67E0); color: #FFFFFF; font-weight: bold; }
QFrame#frameAdminCard { background-color: rgba(47,103,224,0.14); border: 1px solid rgba(47,103,224,0.45); border-radius: 12px; }
QLabel#labelAdminName { font-weight: bold; }
QLabel#labelAdminMail { color: #AEBBDD; font-size: 8pt; }
QLabel#labelOnline { color: #10B981; font-size: 9pt; }

/* ---- barre du haut &amp; titre ---- */
QToolButton#btnBell { background: transparent; border: none; border-radius: 8px; }
QToolButton#btnBell:hover { background-color: rgba(47,103,224,0.25); }
QToolButton#btnAdmin { background: transparent; border: none; border-radius: 10px; text-align: left; padding: 4px 10px; font-weight: bold; }
QToolButton#btnAdmin:hover { background-color: rgba(47,103,224,0.25); }
QToolButton::menu-indicator { image: url(:/icons/chev_w.png); width: 12px; height: 12px; subcontrol-position: right center; subcontrol-origin: padding; right: 4px; }
QLabel[pageTitle=&quot;true&quot;] { font-family: Segoe UI; font-size: 24pt; font-weight: bold; color: #FFFFFF; }
QLabel[pageSub=&quot;true&quot;] { color: #AEBBDD; }

/* ---- cartes ---- */
QFrame[card=&quot;true&quot;], QFrame#frameForm, QFrame#frameList, QFrame#frameStatDonut, QFrame#frameStatBar { background-color: #1C2740; border: 1px solid rgba(47,103,224,0.60); border-radius: 12px; }
QFrame#frameForm QLabel { color: #DCE6FF; }
QLabel#labelFormTitle { font-family: Segoe UI; font-size: 11.5pt; font-weight: bold; color: #FFFFFF; }
QLabel#labelListTitle, QLabel#labelStatDonut, QLabel#labelStatBar { font-family: Segoe UI; font-size: 12pt; font-weight: bold; color: #0BF8F6; }
QLabel#labelCount { color: #AEBBDD; font-size: 9pt; }
QFrame#frameInfo { background-color: rgba(11,248,246,0.06); border: 1px solid rgba(11,248,246,0.35); border-radius: 9px; }
QFrame#frameInfo QLabel { color: #AEBBDD; font-size: 8.5pt; }
QLabel#labelInfoTitle { color: #0BF8F6; font-weight: bold; font-size: 9pt; }

/* ---- champs ---- */
QLineEdit, QComboBox { background-color: #101B31; border: 1px solid rgba(47,103,224,0.65); border-radius: 9px; padding: 5px 10px; color: #FFFFFF; min-height: 20px; selection-background-color: #4B26A0; }
QLineEdit:focus, QComboBox:focus { border: 1px solid #0BF8F6; }
QLineEdit:disabled { background-color: #16223B; color: #8FA3D4; }
QLineEdit#lineId { padding-left: 40px; background-image: url(:/icons/f_idcard.png); background-repeat: no-repeat; background-position: left center; }
QLineEdit#lineNom, QLineEdit#linePrenom { padding-left: 40px; background-image: url(:/icons/f_user.png); background-repeat: no-repeat; background-position: left center; }
QLineEdit#lineEmail { padding-left: 40px; background-image: url(:/icons/f_mail.png); background-repeat: no-repeat; background-position: left center; }
QComboBox#comboRole { padding-left: 40px; background-image: url(:/icons/f_brief.png); background-repeat: no-repeat; background-position: left center; }
QComboBox#comboDept { padding-left: 40px; background-image: url(:/icons/f_build.png); background-repeat: no-repeat; background-position: left center; }
QComboBox#comboEquipes { padding-left: 40px; background-image: url(:/icons/f_users.png); background-repeat: no-repeat; background-position: left center; }
QComboBox#comboDispo { padding-left: 40px; background-image: url(:/icons/f_cal.png); background-repeat: no-repeat; background-position: left center; }
QLineEdit#lineSearch, QLineEdit#lineTopSearch { padding-left: 40px; background-image: url(:/icons/f_search.png); background-repeat: no-repeat; background-position: left center; }
QLineEdit#lineTopSearch { border-radius: 10px; background-color: #1C2740; }
QComboBox::drop-down { border: none; width: 28px; }
QComboBox::down-arrow { image: url(:/icons/chev_w.png); width: 14px; height: 14px; }
QComboBox QLineEdit { border: none; background: transparent; background-image: none; padding: 0; min-height: 0; }
QComboBox QAbstractItemView { background-color: #1C2740; border: 1px solid rgba(47,103,224,0.65); selection-background-color: #4B26A0; selection-color: #FFFFFF; outline: 0; padding: 4px; }
QComboBox QAbstractItemView::indicator { width: 14px; height: 14px; border: 1px solid #2F67E0; border-radius: 3px; background: #101B31; }
QComboBox QAbstractItemView::indicator:checked { background: #0BF8F6; border: 1px solid #0BF8F6; image: url(:/icons/check_w.png); }
QCheckBox { spacing: 8px; }
QCheckBox::indicator { width: 16px; height: 16px; border: 1px solid #2F67E0; border-radius: 4px; background: #101B31; }
QCheckBox::indicator:checked { background: #0BF8F6; border: 1px solid #0BF8F6; image: url(:/icons/check_w.png); }
QCheckBox#checkDispo { color: #0BF8F6; font-weight: bold; }

/* ---- boutons ---- */
QPushButton { background-color: #1C2740; border: 1px solid rgba(47,103,224,0.70); border-radius: 9px; padding: 8px 14px; color: #FFFFFF; }
QPushButton:hover { border: 1px solid #0BF8F6; background-color: #22315A; }
QPushButton:pressed { background-color: #101B31; }
QPushButton:disabled { color: #6F7FA6; border: 1px solid #2B3A5E; }
QPushButton#btnAjouter, QPushButton#btnProfil { background-color: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #4B26A0, stop:1 #2F67E0); border: none; font-weight: bold; }
QPushButton#btnAjouter:hover, QPushButton#btnProfil:hover { background-color: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #6031C9, stop:1 #4A82FF); }
QPushButton#rowBtn { background: transparent; border: none; padding: 3px; border-radius: 5px; }
QPushButton#rowBtn:hover { background-color: rgba(47,103,224,0.30); }

/* ---- tableau ---- */
QTableWidget { font-size: 9pt; background: transparent; alternate-background-color: rgba(255,255,255,0.025); border: none; gridline-color: transparent; selection-background-color: rgba(47,103,224,0.32); selection-color: #FFFFFF; }
QTableWidget::item { padding: 4px; border-bottom: 1px solid rgba(47,103,224,0.22); }
QHeaderView::section { background-color: #1C2740; color: #0BF8F6; padding: 8px 6px; border: none; border-bottom: 1px solid rgba(47,103,224,0.60); font-weight: bold; }
QScrollBar:vertical { background: transparent; width: 9px; margin: 0; }
QScrollBar::handle:vertical { background: #2F67E0; border-radius: 4px; min-height: 24px; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }
QScrollBar:horizontal { background: transparent; height: 9px; }
QScrollBar::handle:horizontal { background: #2F67E0; border-radius: 4px; min-width: 24px; }

/* ---- menus &amp; dialogues ---- */
QMenu { background-color: #1C2740; border: 1px solid rgba(47,103,224,0.65); padding: 4px; }
QMenu::item { padding: 7px 24px; border-radius: 5px; }
QMenu::item:selected { background-color: #4B26A0; }
QMessageBox, QInputDialog, QFileDialog, QDialog { background-color: #1C2740; }
QToolTip { background-color: #1C2740; color: #FFFFFF; border: 1px solid #0BF8F6; }

/* ---- pages d'interface a integrer (modules des autres membres) ---- */
QLabel[phTitle=&quot;true&quot;] { font-family: Segoe UI; font-size: 18pt; font-weight: bold; color: #FFFFFF; }
QLabel[phText=&quot;true&quot;] { color: #AEBBDD; font-size: 11pt; }

QLabel#labelStatDonut, QLabel#labelStatBar { font-size: 11pt; }
