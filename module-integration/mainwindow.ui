QLabel { background: transparent; color: #FFFFFF; font-family: Calibri; font-size: 10pt; }
QLabel#labelBrandRoles { font-family: Segoe UI; font-size: 25pt; font-weight: bold; color: #FFFFFF; }
QLabel#labelTaglineRoles { color: #0BF8F6; font-size: 9pt; font-weight: bold; }
QLabel#labelSubtitleRoles { color: #C9D3EE; font-size: 12pt; }

QFrame[card="true"] { border-radius: 18px; border: 1px solid rgba(124,77,255,0.40); background-color: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 rgba(38,28,98,0.80), stop:0.55 rgba(16,26,66,0.88), stop:1 rgba(8,18,48,0.92)); }
QFrame#cardParticipant { border: 1px solid rgba(45,212,191,0.45); }
QFrame#cardJury { border: 1px solid rgba(124,77,255,0.55); }
QFrame#cardEmploye { border: 1px solid rgba(47,103,224,0.60); }
QFrame#cardParticipant:hover { border: 1px solid #2DD4BF; }
QFrame#cardJury:hover { border: 1px solid #8B5CF6; }
QFrame#cardEmploye:hover { border: 1px solid #3B82F6; }

QLabel#iconParticipant { background-color: rgba(20,184,166,0.16); border: 1px solid rgba(45,212,191,0.40); border-radius: 46px; }
QLabel#iconJury { background-color: rgba(124,77,255,0.18); border: 1px solid rgba(139,92,246,0.50); border-radius: 46px; }
QLabel#iconEmploye { background-color: rgba(47,103,224,0.20); border: 1px solid rgba(59,130,246,0.55); border-radius: 46px; }

QLabel[cardTitle="true"] { font-family: Segoe UI; font-size: 18pt; font-weight: bold; color: #FFFFFF; }
QLabel[cardDesc="true"] { color: #C9D3EE; font-size: 11pt; }
QLabel[bullet="true"] { color: #D5DDF0; font-size: 11.5pt; }
QLabel[chk="teal"] { background-color: #14B8A6; border-radius: 10px; }
QLabel[chk="violet"] { background-color: #5B34D6; border-radius: 10px; }

QPushButton[roleBtn] { border: none; border-radius: 12px; }
QPushButton[roleBtn="teal"] { background-color: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #0B7A66, stop:1 #14B08F); }
QPushButton[roleBtn="teal"]:hover { background-color: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #0E927A, stop:1 #1AD1A9); }
QPushButton[roleBtn="teal"]:pressed { background-color: #0B6B5A; }
QPushButton[roleBtn="violet"] { background-color: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #4B26A0, stop:1 #6B3FE0); }
QPushButton[roleBtn="violet"]:hover { background-color: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #5A31BD, stop:1 #7F55F0); }
QPushButton[roleBtn="violet"]:pressed { background-color: #3C1E85; }
QPushButton[roleBtn="blue"] { background-color: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #1F4FD0, stop:1 #2F6BF0); }
QPushButton[roleBtn="blue"]:hover { background-color: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #2A5DE6, stop:1 #4A82FF); }
QPushButton[roleBtn="blue"]:pressed { background-color: #1B44B5; }
QLabel[btnText="true"] { color: #FFFFFF; font-size: 12.5pt; font-weight: bold; }

QPushButton[subRow="true"] { background-color: rgba(255,255,255,0.045); border: 1px solid rgba(124,140,200,0.25); border-radius: 12px; }
QPushButton[subRow="true"]:hover { background-color: rgba(47,103,224,0.18); border: 1px solid rgba(47,103,224,0.70); }
QPushButton[subRow="true"]:checked { background-color: rgba(11,248,246,0.10); border: 1px solid #0BF8F6; }
QLabel[subIcon="blue"] { background-color: rgba(47,103,224,0.28); border: 1px solid rgba(47,103,224,0.65); border-radius: 9px; }
QLabel[subIcon="violet"] { background-color: rgba(124,77,255,0.28); border: 1px solid rgba(124,77,255,0.65); border-radius: 9px; }
QLabel[subIcon="teal"] { background-color: rgba(20,184,166,0.24); border: 1px solid rgba(45,212,191,0.65); border-radius: 9px; }
QLabel[subTitle="true"] { font-size: 11.5pt; font-weight: bold; color: #FFFFFF; }
QLabel[subDesc="true"] { font-size: 9.5pt; color: #AEBBDD; }
QLabel#labelHintEmploye { color: #F87171; background-color: rgba(239,68,68,0.12); border: 1px solid #EF4444; border-radius: 8px; padding: 6px 10px; font-size: 10pt; }

QFrame#frameInfoRoles { background-color: rgba(28,39,64,0.55); border: 1px solid rgba(47,103,224,0.35); border-radius: 16px; }
QLabel#labelRolesInfoTitle { font-size: 13pt; font-weight: bold; color: #FFFFFF; }
QLabel#labelRolesInfoText { font-size: 11pt; color: #AEBBDD; }
