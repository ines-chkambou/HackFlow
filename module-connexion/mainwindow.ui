QFrame#frameLeftLogin { background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #031A47, stop:0.45 #00112D, stop:1 #06123A); }
QWidget#widgetLeftTopLogin { background: transparent; }
QFrame#frameRightLogin { background-color: #020F2A; }
QFrame#frameCardLogin { background-color: #00132F; border: 1px solid rgba(47,103,224,0.38); border-radius: 18px; }

QLabel { background: transparent; }
QLabel#labelBrandLogin { color: #FFFFFF; font-size: 28pt; font-weight: bold; }
QLabel#labelTaglineLogin { color: #38B6F6; font-size: 9.5pt; }
QLabel#labelHeroLogin { color: #FFFFFF; font-size: 26pt; font-weight: bold; }
QLabel#labelDescLogin { color: #B7C3E2; font-size: 14pt; }
QLabel#labelTitleLogin { color: #FFFFFF; font-size: 23pt; font-weight: bold; }
QLabel#labelSubLogin { color: #AEBBDD; font-size: 13pt; }
QLabel#labelNoAccountLogin { color: #D5DDF0; font-size: 12.5pt; }
QLabel#labelErrorLogin { color: #F87171; background-color: rgba(239,68,68,0.12); border: 1px solid #EF4444; border-radius: 8px; padding: 8px 12px; font-size: 10.5pt; }

QLineEdit { background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #05264F, stop:1 #031A42); border: 1px solid rgba(47,103,224,0.85); border-radius: 12px; padding: 12px 50px 12px 50px; color: #FFFFFF; font-size: 13pt; selection-background-color: #4B26A0; }
QLineEdit:focus { border: 1px solid #0BF8F6; }
QLineEdit[error="true"] { border: 1px solid #EF4444; }
QLineEdit#lineEmailLogin { background-image: url(:/icons/login_f_user.png); background-repeat: no-repeat; background-position: left center; }
QLineEdit#linePasswordLogin { background-image: url(:/icons/login_f_lock.png); background-repeat: no-repeat; background-position: left center; }
QToolButton#btnEyeLogin { background: transparent; border: none; margin-right: 10px; }
QToolButton#btnEyeLogin:hover { background-color: rgba(47,103,224,0.25); border-radius: 6px; }

QCheckBox { color: #C9D3EE; spacing: 12px; font-size: 13pt; background: transparent; }
QCheckBox::indicator { width: 18px; height: 18px; border: 2px solid #5A6FD8; border-radius: 5px; background: transparent; }
QCheckBox::indicator:checked { background: #0BF8F6; border: 2px solid #0BF8F6; image: url(:/icons/login_check.png); }

QPushButton#btnLogin { background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #38ABFD, stop:0.3 #4472FC, stop:0.7 #6D44FA, stop:1 #A04CF6); color: #FFFFFF; font-size: 13.5pt; font-weight: bold; border: none; border-radius: 12px; padding: 14px; min-height: 22px; }
QPushButton#btnLogin:hover { background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #5BBDFF, stop:0.3 #5F86FF, stop:0.7 #8260FF, stop:1 #B565FF); }
QPushButton#btnLogin:pressed { background-color: #2D175A; }
QPushButton#btnForgotLogin, QPushButton#btnCreateAccountLogin { background: transparent; border: none; padding: 4px; }
QPushButton#btnForgotLogin { color: #AEBBDD; font-size: 11.5pt; }
QPushButton#btnForgotLogin:hover { color: #0BF8F6; }
QPushButton#btnCreateAccountLogin { color: #20B4F2; font-size: 12.5pt; font-weight: bold; }
QPushButton#btnCreateAccountLogin:hover { color: #6FD3FF; }
QFrame#lineSepLogin { background-color: rgba(47,103,224,0.28); border: none; max-height: 1px; min-height: 1px; }
