  <property name="styleSheet">
   <string notr="true">
/* ===================================================================
   HACKFLOW DARK THEME STYLESHEET (Conforme à la palette Tableau 10)
   Navy Fond: #101B31 | Cadre Métal: #1C2740 | Flux Cyan: #0BF8F6
   Flux Violet: #4B26A0 | Flux Bleu: #2F67E0 | Texte: #FFFFFF
   =================================================================== */

QMainWindow, QWidget#centralWidget {
    background-color: #01143C;
    color: #FFFFFF;
    font-family: 'Segoe UI', Arial, sans-serif;
}

QFrame#sidebarWidget {
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, stop:0 #001741, stop:1 #011D52);
    border-right: 1px solid #308ABC;
}

QFrame#topBarWidget {
    background-color: #00153F;
    border-bottom: 1px solid #0A2A63;
}

QFrame#breadcrumbWidget {
    background-color: #121E36;
    border-bottom: 1px solid #1C2740;
}

/* Cartes et panneaux */
QFrame[class="cardFrame"], QWidget[class="cardFrame"] {
    background-color: #1C2740;
    border: 1px solid #233354;
    border-radius: 12px;
}

/* Boutons de la sidebar */
QPushButton[class="navButton"] {
    background-color: transparent;
    color: #E6EEFF;
    text-align: left;
    padding: 10px 16px 10px 24px;
    min-height: 33px;
    margin: 0px;
    border-radius: 10px;
    font-size: 15px;
    font-weight: 400;
    border: none;
}
QPushButton[class="navButton"]:hover {
    background-color: rgba(30, 144, 255, 0.12);
    color: #FFFFFF;
}
QPushButton[class="navButtonActive"] {
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 #0169FD, stop:1 #0097FE);
    color: #FFFFFF;
    text-align: left;
    padding: 10px 16px 10px 24px;
    min-height: 33px;
    margin: 6px 0px;
    border-radius: 10px;
    font-size: 15px;
    font-weight: 500;
    border: none;
}

/* Champs de saisie */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QTextEdit {
    background-color: #121D34;
    border: 1px solid #2A3B5C;
    border-radius: 8px;
    padding: 8px 12px;
    color: #FFFFFF;
    font-size: 12px;
}
QLineEdit:focus, QComboBox:focus, QTextEdit:focus {
    border: 1px solid #0BF8F6;
    background-color: #162442;
}
QLineEdit:disabled {
    background-color: #0D1527;
    color: #64748B;
    border: 1px solid #1A263D;
}

/* Boutons principaux et secondaires */
QPushButton[class="btnPrimary"] {
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 #2F67E0, stop:1 #4B26A0);
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 9px 18px;
    font-size: 12px;
    font-weight: bold;
}
QPushButton[class="btnPrimary"]:hover {
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 #3B82F6, stop:1 #6366F1);
}
QPushButton[class="btnPrimary"]:pressed {
    background-color: #1D4ED8;
}

QPushButton[class="btnSecondary"] {
    background-color: #1E293B;
    color: #E2E8F0;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 12px;
}
QPushButton[class="btnSecondary"]:hover {
    background-color: #334155;
    border-color: #475569;
}

QPushButton[class="btnCyan"] {
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 #0BF8F6, stop:1 #2F67E0);
    color: #0E172A;
    border: none;
    border-radius: 8px;
    padding: 9px 18px;
    font-size: 12px;
    font-weight: bold;
}
QPushButton[class="btnCyan"]:hover {
    background: #0BF8F6;
    color: #000000;
}

/* Tableaux */
QTableWidget {
    background-color: #152037;
    border: 1px solid #233354;
    border-radius: 8px;
    gridline-color: #1F2D47;
    color: #FFFFFF;
    selection-background-color: #2F67E0;
    selection-color: #FFFFFF;
}
QHeaderView::section {
    background-color: #1C2740;
    color: #94A3B8;
    padding: 8px 6px;
    border: none;
    border-bottom: 2px solid #233354;
    font-weight: bold;
    font-size: 11px;
}
QTableWidget::item {
    padding: 6px;
    border-bottom: 1px solid #1B2844;
}
QTableWidget::item:hover {
    background-color: #1A2846;
}

/* Scrollbars */
QScrollBar:vertical {
    border: none;
    background: #0E172A;
    width: 8px;
    border-radius: 4px;
}
QScrollBar::handle:vertical {
    background: #2A3B5C;
    border-radius: 4px;
    min-height: 20px;
}
QScrollBar::handle:vertical:hover {
    background: #0BF8F6;
}
